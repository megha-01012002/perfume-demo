# Base URL for the Express API (server/server.js). Leave as /api to use
# the Vite dev proxy defined in vite.config.js.
VITE_API_URL=/api

# When true (default), the app runs against localStorage-backed mock
# services (see src/services/authService.js, orderService.js,
# paymentService.js) so the full UI can be demoed with no backend
# running. Set to false once the Express + MongoDB backend is running
# to use the real API.
VITE_USE_MOCK_API=true
