# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/eloria

# Long, random secret used to sign JWTs — generate a real one for production
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Razorpay (https://dashboard.razorpay.com/app/keys) — leave blank to run
# the API in demo payment mode (see controllers/paymentController.js)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# URL of the deployed frontend, used for CORS
CLIENT_URL=http://localhost:5173

PORT=5000
NODE_ENV=development
